      "params": {
        "x0": 0.2,
        "limit": false,
        "upper": 1.0,
        "lower": -1.0,
        "reset": "none"
      },
      "x": 440,
      "y": 0
    },
    {
      "id": "Kp",
      "type": "Gain",
      "params": {
        "gain": -40.0
      },
      "x": 220,
      "y": 180,
      "flip": true
    },
    {
      "id": "Kd",
      "type": "Gain",
      "params": {
        "gain": -10.0
      },
      "x": 440,
      "y": 180,
      "flip": true
    },
    {
      "id": "tau",
      "type": "Sum",
      "params": {
        "signs": "++"
      },
      "x": 0,
      "y": 180,
      "flip": true
    },
    {
      "id": "phase",
      "type": "XYGraph",
      "params": {
        "title": "Phase portrait"
      },
      "x": 660,
      "y": 90
    }
  ],
  "connections": [
    {
      "src": "th.out",
      "dst": "mx.in1"
    },
    {
      "src": "w.out",
      "dst": "mx.in2"
    },
    {
      "src": "tau.out",
      "dst": "mx.in3"
    },
    {
      "src": "mx.out",
      "dst": "f.in"
    },
    {
      "src": "f.out",
      "dst": "w.in"
    },
    {
      "src": "w.out",
